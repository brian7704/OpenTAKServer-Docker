# Copy this file to .env. The setup script generates strong secrets automatically.
OTS_FQDN=nas.example.com
PUBLIC_HOST=nas.example.com
PUBLIC_BASE_URL=https://nas.example.com

# Registration portal branding. Change these without editing the application.
BRAND_NAME=TAYA TAK
BRAND_SHORT=T
BRAND_TAGLINE=私人 OpenTAK 服務
BRAND_DESCRIPTION=OpenTAK Server 帳號申請與 ATAK 設定包下載
BRAND_PRIMARY_COLOR=#3dd6e8
BRAND_ACCENT_COLOR=#ffba4a
# Optional same-origin image, for example /static/custom-logo.svg. Empty uses BRAND_SHORT.
BRAND_LOGO_URL=
# Leave empty to hide the support link.
SUPPORT_LABEL=PayPal.Me/tayashot
SUPPORT_URL=https://paypal.me/tayashot

POSTGRES_USER=ots
POSTGRES_DB=ots
POSTGRES_PASSWORD=CHANGE_ME
SQLALCHEMY_DATABASE_URI=postgresql+psycopg://ots:CHANGE_ME@database/ots
PGUSER=ots

OTS_RABBITMQ_SERVER_ADDRESS=rabbitmq
OTS_LISTENER_ADDRESS=0.0.0.0
OTS_MEDIAMTX_API_ADDRESS=http://mediamtx:9997
OTS_VERIFY_TLS=false

OTS_API_PORT=8081
OTS_WEB_PORT=8080
OTS_HTTPS_PORT=8443
OTS_ENROLLMENT_PORT=8446
OTS_COT_PORT=8088
OTS_SSL_COT_PORT=8089
REGISTER_PORT=8787
STREAM_PORT=8089
ENROLLMENT_PORT=8446
RTMP_PORT=1935
RTP_PORT=8000
RTCP_PORT=8001
WEBRTC_UDP_PORT=8189
RTSP_PORT=8554
HLS_PORT=8888
WEBRTC_PORT=8889
SRT_PORT=8890

PACKAGE_TTL_HOURS=72
ADMIN_SESSION_MINUTES=20
APPLICANT_SESSION_MINUTES=15

# Optional email delivery. Leave SMTP_HOST empty to keep download-only mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
# For port 465 use SMTP_SSL=true and SMTP_STARTTLS=false.
SMTP_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

